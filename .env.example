# --- Access control ----------------------------------------------------------
# Shared passphrase. Anyone with it can use the app; change it to revoke access.
# Fails closed: if unset, nobody can sign in (including you).
ACCESS_PASSPHRASE=""

# Secret used to sign the session cookie. Any long random string.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=""

# --- Research provider -------------------------------------------------------
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional. Must support BOTH Google Search grounding and JSON response schemas.
# Verify against current Google docs before changing.
# GEMINI_MODEL="gemini-2.5-flash"

# Set to "fake" to run against fixtures with no API key and no quota use.
# BRIEF_PROVIDER="fake"
