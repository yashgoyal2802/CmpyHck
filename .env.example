# --- Access control ----------------------------------------------------------
# Secret used to sign the session cookie. Any long random string.
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=""

# Accounts are provisioned into the database, not set via env var. See:
#   npm run provision-account -- <username> <password>

# --- Research provider -------------------------------------------------------
# Gemini API key: https://aistudio.google.com/apikey
# Only backs the admin account's brief generation. Every other account
# supplies its own free Gemini key at sign-in (required for standard and
# search_only accounts); that key lives on the session only, never here.
GEMINI_API_KEY=""

# Optional. Must support BOTH Google Search grounding and JSON response schemas.
# Verify against current Google docs before changing.
# GEMINI_MODEL="gemini-2.5-flash"

# Set to "fake" to run against fixtures with no API key and no quota use.
# BRIEF_PROVIDER="fake"

# --- Fallback research provider (optional) ------------------------------------
# When all three are set, a Gemini infrastructure-class failure (rate limit,
# provider error, not configured, malformed response) is automatically
# retried through this fallback instead of failing the request. Shared by
# every account regardless of role - not something a non-admin account needs
# its own credentials for. Absent any of the three, the app behaves exactly
# as it does without this feature.
# OPENROUTER_API_KEY="": https://openrouter.ai/keys
# Verify current free-tier availability at https://openrouter.ai/api/v1/models
# before trusting any example value here - free-model availability changes
# without notice (see the GEMINI_MODEL note above, learned the hard way).
# OPENROUTER_MODEL=""
# TAVILY_API_KEY="": https://tavily.com

# --- Storage -------------------------------------------------------------------
# Postgres connection string (Vercel's Neon integration sets this automatically
# when the project is linked; also accepts POSTGRES_URL for the same reason).
DATABASE_URL=""

# Set to "memory" to run against an in-process store with no database, no
# persistence across restarts — useful for local dev before a DB is provisioned.
# STORAGE_PROVIDER="memory"

# Only used when STORAGE_PROVIDER=memory: seeds one account at startup so
# local dev doesn't also need a database to sign in. Defaults to the
# "standard" role, which now also requires a Gemini API key at sign-in - set
# DEV_ACCOUNT_ROLE="admin" if you'd rather skip that locally.
# DEV_ACCOUNT_USERNAME="dev"
# DEV_ACCOUNT_PASSWORD="dev"
# DEV_ACCOUNT_ROLE="admin"

# Optional. Seconds before a cached company's stable facts are treated as
# expired and re-researched. Defaults to 30 days.
# CACHE_TTL_SECONDS="2592000"
